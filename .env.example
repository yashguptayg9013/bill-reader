# Required: your Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: model and effort (defaults: claude-opus-5-5, low)
# BILL_READER_MODEL=claude-opus-5-5
# BILL_READER_EFFORT=low

# Optional: Google Sheets export (see google-apps-script/Code.gs)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_SHEETS_SECRET=

# Public demo: when set, anyone can run the sample bills, but reading their own
# bill or sending to Google Sheets needs this passcode. Leave unset locally.
# DEMO_PASSCODE=
